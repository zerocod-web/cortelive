#!/usr/bin/env sh
set -eu

GITLEAKS_BIN=""
if command -v gitleaks >/dev/null 2>&1; then
  GITLEAKS_BIN="gitleaks"
elif [ -n "${LOCALAPPDATA:-}" ] && [ -x "$LOCALAPPDATA/Microsoft/WinGet/Links/gitleaks.exe" ]; then
  GITLEAKS_BIN="$LOCALAPPDATA/Microsoft/WinGet/Links/gitleaks.exe"
elif [ -n "${LOCALAPPDATA:-}" ]; then
  for candidato in "$LOCALAPPDATA"/Microsoft/WinGet/Packages/Gitleaks.Gitleaks_*/gitleaks.exe; do
    if [ -x "$candidato" ]; then
      GITLEAKS_BIN="$candidato"
      break
    fi
  done
fi

if [ -z "$GITLEAKS_BIN" ]; then
  echo "[pre-commit] ERRO: gitleaks nao encontrado. Instale com: winget install --id Gitleaks.Gitleaks -e" >&2
  exit 1
fi

"$GITLEAKS_BIN" protect --staged --redact --verbose
